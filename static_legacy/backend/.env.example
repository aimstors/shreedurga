# ── Shree Durga Interior · Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Server ──
NODE_ENV=production
PORT=3001

# ── Supabase ──
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Email (SMTP) ──
# For Gmail: Enable 2FA → App Passwords → Generate password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shreedurgainterior50@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE

# ── Notifications ──
NOTIFY_EMAIL=shreedurgainterior50@gmail.com

# ── Admin ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=GENERATE_A_SECURE_RANDOM_KEY_HERE

# ── CORS ──
ALLOWED_ORIGINS=https://shreedurgainterior.in,https://www.shreedurgainterior.in

# ── Frontend URL ──
FRONTEND_URL=https://shreedurgainterior.in
