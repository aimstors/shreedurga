# .htaccess — Shree Durga Interior (cPanel / Apache)
# Place in: public_html/.htaccess

Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www (or add www — pick one)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Proxy /api/ to Node.js backend (if using cPanel Node.js app)
# Adjust port to match your Node.js app port in cPanel
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ http://localhost:3001/api/$1 [P,L]

# Route .html pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Security — block sensitive files
<FilesMatch "(\.env|\.git|package\.json|server\.js|node_modules)">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Cache Control ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType application/json       "access plus 0 seconds"
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Security Headers ──
<IfModule mod_headers.c>
  Header always set X-Frame-Options          "SAMEORIGIN"
  Header always set X-Content-Type-Options   "nosniff"
  Header always set X-XSS-Protection         "1; mode=block"
  Header always set Referrer-Policy          "strict-origin-when-cross-origin"
  Header always set Permissions-Policy       "camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Remove Server header
  Header unset Server
  Header always unset X-Powered-By
</IfModule>

# ── Error pages ──
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
